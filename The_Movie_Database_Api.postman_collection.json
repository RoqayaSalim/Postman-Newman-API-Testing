    {
      "name": "Popular Movies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains results array\", function () {\r",
              "    pm.expect(response).to.have.property(\"results\");\r",
              "    pm.expect(response.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Results contain 20 movies per page\", function () {\r",
              "    pm.expect(response.results).to.have.lengthOf(20);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains pagination fields\", function () {\r",
              "    pm.expect(response).to.have.property(\"page\");\r",
              "    pm.expect(response).to.have.property(\"total_pages\");\r",
              "    pm.expect(response).to.have.property(\"total_results\");\r",
              "});\r",
              "\r",
              "pm.test(\"Page number is 1\", function () {\r",
              "    pm.expect(response.page).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Each movie contains required fields\", function () {\r",
              "    response.results.forEach(movie => {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"vote_average\");\r",
              "        pm.expect(movie).to.have.property(\"popularity\");\r",
              "\r",
              "       // pm.expect(movie.popularity).to.be.a(\"number\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Movies are sorted by popularity descending\", function () {\r",
              "    const popularityValues = response.results.map(movie => movie.popularity);\r",
              "\r",
              "    for (let i = 0; i <popularityValues.length - 1; i++) {\r",
              "if (popularityValues[i] < popularityValues[i+1]) {\r",
              "console.log(`movie at index ${i} is not greater than the movie at index ${i+1}`);\r",
              "\r",
              "pm.expect.fail(\r",
              "                `Movies are not sorted by popularity descending at index ${i}`\r",
              "            );\r",
              "\r",
              "}\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "else {\r",
              "\r",
              "        pm.expect(popularityValues[i]).to.be.at.least(popularityValues[i+1]);\r",
              "    }}\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
