    {
      "name": "Movies by Keyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains results array\", function () {\r",
              "    pm.expect(response).to.have.property(\"results\");\r",
              "    pm.expect(response.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Total results is greater than 0\", function () {\r",
              "    pm.expect(response.total_results).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Movie titles are relevant to the search keyword\", function () {\r",
              "    const keyword = \"inception\";\r",
              "\r",
              "    response.results.forEach(movie => {\r",
              "        pm.expect(movie.title.toLowerCase()).to.include(keyword);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Each movie contains required fields\", function () {\r",
              "    response.results.forEach(movie => {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "        pm.expect(movie).to.have.property(\"overview\");\r",
